# ==============================================================
# ĀRYĀVARTA - Indian Cultural Heritage Platform Environment Config
# ==============================================================

# Google Gemini Multimodal AI (Dance Classification & Storytelling)
GEMINI_API_KEY=your_gemini_api_key_here

# Mapbox 3D Satellite & GIS (Monument Mapping)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Groq High-Speed LLM Inference (Llama 70B / 120B)
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI (Indian Multilingual TTS & Audio Synthesis - Bulbul v3)
SARVAM_API_KEY=your_sarvam_api_key_here

# Supabase Cloud Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct Database Connections (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"

# Local AI Microservice Gateway (FastAPI)
NEXT_PUBLIC_AI_GATEWAY_URL=http://localhost:8000
